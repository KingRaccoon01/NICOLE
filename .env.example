# Nicole ayarları — bu dosyayı ".env" adıyla kopyala ve doldur.
# Sadece GEMINI_API_KEY zorunlu (Editör sohbeti için); geri kalanların hepsinin varsayılanı var.

# --- Gemini (AI Editör sohbeti) ---
# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Ana model kota/yoğunluk hatası verirse sırayla denenecek yedekler (virgülle)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

# --- Flag taraması (yanlış duyulan kelimeler + kurgusal adlar) ---
# ollama: yerel, internetsiz | gemini: daha isabetli; Editör'ün kotasını yememek için ayrı model kullanır,
# hata verirse (kota/internet) otomatik Ollama'ya düşer
FLAG_ENGINE=ollama
FLAG_GEMINI_MODEL=gemini-flash-lite-latest
# Yaygın kelime eşiği (yükselirse daha az kelime "yaygın" sayılıp elenir)
FLAG_COMMON_WORD_ZIPF=3.5

# --- Ollama (yerel model) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Önce: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# --- Whisper (sesi yazıya dökme) ---
# tiny, base, small, medium, large-v3 — büyüdükçe daha doğru ama daha yavaş.
# NVIDIA GPU varsa medium önerilir: Türkçe denemede kelime hatası small'da %42, medium'da %17 çıktı.
WHISPER_MODEL_SIZE=small
# NVIDIA GPU + CUDA varsa: cuda (yoksa kod otomatik cpu'ya düşer)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=tr
WHISPER_PRELOAD=true
# 0 = otomatik
WHISPER_CPU_THREADS=0
# Whisper'ın bu eminliğin altında yazdığı kelimeler işaretlenir ve flag taramasına bildirilir.
# Çok işaret çıkıyorsa düşür (0.35), yanlış duyulanlar kaçıyorsa yükselt (0.65).
WHISPER_UNCERTAIN_PROB=0.5
# Hikâyendeki özel isimler (virgülle) — Whisper'a ipucu olur. Lore Sözlüğü terimleri zaten otomatik eklenir.
WHISPER_VOCABULARY_HINT=

# --- Veritabanı (boş bırakılırsa proje klasöründeki nicole.db) ---
# DATABASE_URL=sqlite+aiosqlite:///C:/yol/nicole.db
